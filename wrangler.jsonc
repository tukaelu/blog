{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bonsai-blog",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    // nuxt-og-imageのフォント読み込みに必要。main/assetsは nitro.cloudflare.deployConfig により
    // ビルド時に .output/server/wrangler.json で上書きされる（architecture.md §10, §11.1参照）
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-cms-production",
      "database_id": "46f32890-d7d5-4a6e-b860-2101246426e5",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "blog-cms-production" }],
  // いいねAPIの濫用対策（architecture.md §8.2）。同一IPからの連打を制限する
  "ratelimits": [
    {
      "name": "LIKE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    // og-fetchは未認証で任意URLをfetchするエンドポイントのため、オープンプロキシ的な
    // 濫用・サーバー自体への負荷攻撃を防ぐため同一IPからの連打を制限する
    {
      "name": "OG_FETCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
