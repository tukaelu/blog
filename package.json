{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "nuxt build && wrangler deploy",
    "postinstall": "nuxt prepare",
    "check": "nuxi typecheck",
    "test:unit": "vitest run",
    "test:e2e": "wrangler d1 migrations apply blog-cms --local && pnpm seed:e2e && playwright test",
    "seed:e2e": "vite-node --config vitest.config.ts scripts/seed-test-data.ts --",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lucide/vue": "^1.35.0",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs-precompiled": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@takumi-rs/helpers": "^2.13.0",
    "@takumi-rs/wasm": "^2.12.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "image-size": "^2.0.2",
    "mermaid": "^11.17.2",
    "node-html-parser": "^9.0.2",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unwasm": "^0.6.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "drizzle-kit": "0.31.10",
    "nitro-cloudflare-dev": "0.2.2",
    "prettier": "3.8.4",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-node": "6.0.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "wrangler": "4.127.1"
  }
}
